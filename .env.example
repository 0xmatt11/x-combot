# X developer App credentials (OAuth 2.0 user-context, not app-only).
# Create a Project + App at https://developer.x.com and enable OAuth 2.0.
CLIENT_ID=your_oauth2_client_id
CLIENT_SECRET=your_oauth2_client_secret

# Must match a Callback URI configured on the App (User authentication settings).
REDIRECT_URI=http://127.0.0.1:3000/callback

# User access token for the bot account. Prefer `npm run oauth` which writes
# data/tokens.json (including a refresh token when offline.access is granted).
# You can also paste a token here; user tokens typically expire in ~2 hours
# without a refresh token.
ACCESS_TOKEN=
REFRESH_TOKEN=

# X numeric user ID of the bot account owner. Always treated as an admin.
BOT_OWNER_ID=1234567890

# Optional comma-separated X numeric user IDs that may run mod commands
# in every conversation the bot can see.
ADMIN_IDS=

# Optional: set if you already know the bot account's numeric user ID.
# Otherwise the bot calls GET /2/users/me on startup.
BOT_USER_ID=

# OpenAI-compatible chat completions (optional). Required for !ask / @bot /
# !summarize / !analyze. Any provider that implements POST /chat/completions
# works via OPENAI_BASE_URL (include the /v1 suffix when the vendor uses it).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional overrides
# CONFIG_PATH=config/default.yaml
# DATABASE_PATH=data/bot.sqlite
# POLL_INTERVAL_MS=12000
# TOKEN_PATH=data/tokens.json
