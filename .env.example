# X developer App credentials (OAuth 2.0 user-context, not app-only).
# Create a Project + App at https://developer.x.com and enable OAuth 2.0.
CLIENT_ID=your_oauth2_client_id
CLIENT_SECRET=your_oauth2_client_secret

# Must match a Callback URI configured on the App (User authentication settings).
REDIRECT_URI=http://127.0.0.1:3000/callback

# User access token for the bot account. Prefer `npm run oauth` which writes
# data/tokens.json (including a refresh token when offline.access is granted).
# You can also paste a token here; user tokens typically expire in ~2 hours
# without a refresh token.
ACCESS_TOKEN=
REFRESH_TOKEN=

# Human owner's numeric user ID. Always an admin. Do not run `npm run oauth` as this account.
BOT_OWNER_ID=1234567890

# Optional comma-separated X numeric user IDs that may run mod commands
# in every conversation the bot can see.
ADMIN_IDS=

# Numeric user ID of the OAuth'd bot account (the token), not the owner.
# Optional: if unset, startup uses GET /2/users/me. Must match the authorized account when set.
BOT_USER_ID=

# LLM provider: openai (default) | grok | local
# Aliases: xai → grok; ollama, lmstudio, openai-compatible → local
# Env LLM_PROVIDER wins over config/default.yaml llm.provider.
# LLM_PROVIDER=openai
# LLM_MODEL=

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# xAI Grok (LLM_PROVIDER=grok or xai)
# Chat Completions: POST https://api.x.ai/v1/chat/completions
# Key precedence: XAI_API_KEY > LLM_API_KEY > OPENAI_API_KEY
# Default model: grok-4.6 (override with LLM_MODEL)
# XAI_API_KEY=

# Local PC (LLM_PROVIDER=local / ollama / lmstudio)
# Default Ollama: http://127.0.0.1:11434/v1  (LM Studio alias: http://127.0.0.1:1234/v1)
# No cloud key required; LLM_API_KEY may be omitted or set to a dummy like "ollama".
# If the bot is not on the same machine, 127.0.0.1 will not reach your PC —
# set LLM_BASE_URL to the PC's LAN IP or a tunnel.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=

# Optional overrides
# CONFIG_PATH=config/default.yaml
# DATABASE_PATH=data/bot.sqlite
# YAML default is 12000. Use 30000 on a live Chat group until Activity push is on.
# POLL_INTERVAL_MS=30000
# TOKEN_PATH=data/tokens.json

# Encrypted X Chat groups (https://x.com/i/chat/g…). Comma-separated `g` + digits.
# Leave unset once this account has a Chat identity (data/chat-keys.json or CHAT_PIN).
# The bot then moderates every encrypted group it is added to. No restart per group.
# Set this only to limit the bot to those ids (allowlist override).
# CHAT_CONVERSATION_IDS=gYOUR_GROUP_ID
# Optional groups to skip in either mode.
# CHAT_CONVERSATION_DENY_IDS=
# all | allowlist | off. Unset: all groups when a Chat identity exists and the
# allowlist above is empty; allowlist when CHAT_CONVERSATION_IDS is set;
# off when there is no identity and no allowlist (classic group DMs only).
# CHAT_LISTEN=all
# `npm run chat:rotate -- gYOUR_GROUP_ID --confirm` aborts with no POST if any
# current member has an empty GET /2/users/{id}/public_keys (never opened Chat).
# Unencrypted identity blob (mode 0600). Written by `npm run chat:register`
# or by the first successful Juicebox unlock. Gitignored (data/ and chat-keys.json).
# Later starts load this file and do not need CHAT_PIN.
# CHAT_KEYS_PATH=data/chat-keys.json
# One-time Juicebox PIN. Requires `npm install juicebox-sdk`.
# After the key file exists and matches a registered public key, the file wins.
# Never log this value or the private key bytes.
# CHAT_PIN=
# CHAT_POLL_INTERVAL_MS=30000
# Quiet Chat polls stretch up to this (doubling) when Activity push is off.
# CHAT_POLL_IDLE_MAX_MS=120000
# Classic GET /2/dm_events. Unset: skipped while encrypted Chat is active.
# Set true to moderate classic group DMs and Chat together.
# DM_POLL=true

# X Activity API (chat.received) so busy groups are not limited to polling.
# Scopes stay dm.read / dm.write / tweet.read / users.read / offline.access.
# dm.read is the documented scope for chat.* subscriptions. No extra scope.
# ACTIVITY_ENABLED=true
# ACTIVITY_TRANSPORT=stream
# stream | webhook | both
# ACTIVITY_SUBSCRIBE=true
# App-only bearer. Required for list (GET /2/activity/subscriptions) and
# the stream (GET /2/activity/stream), and used for POST /2/webhooks.
# Create chat.received uses the user access token (scope dm.read).
# ACTIVITY_BEARER_TOKEN=
# ACTIVITY_WEBHOOK_PORT=8080
# ACTIVITY_WEBHOOK_PATH=/webhook
# Public HTTPS URL X will call (no port in the URL). Register it with POST /2/webhooks.
# ACTIVITY_WEBHOOK_URL=https://example.com/webhook

# XP / levels. On by default (config/default.yaml xp.enabled). Env wins.
# XP_ENABLED=false turns passive XP, !xp / !top, and reply + / - off.
# Amounts, cooldowns, and the + / - switch stay in YAML (`xp:`).
# XP_ENABLED=true

# !boobs — chest / cleavage photo. !ass and !booty use the same switch for a
# butt-from-behind photo. Default off (see config/default.yaml boobs.enabled).
# Env wins over YAML. Set false to force it off even when the YAML says true.
# Rate limits live in YAML (`boobs.rate_limit_*`) and default to 0 (unlimited).
# BOOBS_ENABLED=true
# Optional vision check after the text filter. Default off (boobs.vision in YAML).
# When true, the bot downloads a few candidates and asks the configured LLM
# (OpenAI, Grok/xAI, or a local OpenAI-compatible server) whether the image
# matches the command and shows no genitalia. A failed or timed-out check skips
# that image. Text filtering still applies when this is false.
# BOOBS_VISION=false
# Search provider: duckduckgo (default, no key) | reddit | serpapi | bing
# Aliases for duckduckgo: ddg, ddgs. No API key.
# DuckDuckGo loads a vqd token from duckduckgo.com, then i.js with safesearch off.
# If that fails or returns nothing, the bot tries keyless Bing HTML
# (https://www.bing.com/images/async, adlt=off) and then Reddit.
# That Bing HTML path does not use BOOBS_SEARCH_API_KEY.
# reddit reads gateway.reddit.com desktop listings (NSFW / over_18 only).
# Public www.reddit.com hot.json is a fallback; cloud IPs are often blocked from it.
# serpapi uses Google Images (safe=off).
# bing is the Azure Bing Image Search API (safeSearch=Off), not the HTML fallback.
# Both keyed providers require BOOBS_SEARCH_API_KEY. Never commit a real key.
# BOOBS_SEARCH_PROVIDER=duckduckgo
# BOOBS_SEARCH_API_KEY=
# Image source for !boobs, !ass, and !booty.
# imagine (default when XAI_API_KEY, or the grok LLM key stack, is set) calls
# POST https://api.x.ai/v1/images/generations with that bearer token.
# search forces the DuckDuckGo → Bing HTML → Reddit cascade above.
# If Imagine fails for a reason other than content moderation, or imagine is
# selected and the key is missing, search is the fallback. A moderation
# rejection is posted in the chat with five softer prompts and does not search.
# Search skips the last 8 posted image URLs and content hashes in that conversation.
# BOOBS_IMAGE_PROVIDER=imagine
# Model: grok-imagine-image-quality (default), grok-imagine-image, or grok-imagine-image-2.0
# BOOBS_IMAGINE_MODEL=grok-imagine-image-quality
# Optional aspect ratio (1:1, 3:4, 2:3, 16:9, 9:16, 4:3, auto, …). Omit to let the model choose.
# BOOBS_IMAGINE_ASPECT_RATIO=
# Optional public-CDN JPEG for !boobs / !ass / !booty. Default off.
# Does not open grok.com, does not log in, and does not pass the age gate.
# When true, a command uses the matching URL only after API Imagine misses
# (missing key, or a failure other than content moderation) and before search.
# An API moderation rejection still stays in chat and does not use the URL.
# Copy the address from an image already on grok.com/imagine. No query string.
# A bad URL fails startup. Unset URLs skip this step and keep API/search.
# BOOBS_IMAGINE_APP=false
# BOOBS_IMAGINE_PUBLIC_URL=https://imagine-public.x.ai/imagine-public/images/<uuid>.jpg
# BOOBS_IMAGINE_PUBLIC_BOOTY_URL=https://imagine-public.x.ai/imagine-public/images/<uuid>.jpg
# !imagine <prompt> uses the same client, model, and aspect ratio. It does not use image search.
# A blank !imagine gets a usage reply. Prompts are trimmed and sent as written.
# This bot does not cap prompt length. If the API rejects one for length, the chat says so.
# !video <prompt> uses the same xAI key. It POSTs /v1/videos/generations and polls
# GET /v1/videos/{request_id} until the clip is ready (often a few minutes).
# VIDEO_IMAGINE_MODEL=grok-imagine-video-1.5
# Duration is 1–15 seconds. Unset uses 5.
# VIDEO_IMAGINE_DURATION=5
# Aspect ratio: 16:9 (default), 9:16, 1:1, 4:3, 3:4, 3:2, 2:3.
# VIDEO_IMAGINE_ASPECT_RATIO=16:9
# Resolution: 720p (default), 480p, or 1080p.
# VIDEO_IMAGINE_RESOLUTION=720p
# !voice <persona> <text> uses the same xAI key. It POSTs /v1/tts and posts the MP3 in encrypted Chat.
# Personas (not raw voice ids): sexy/1, dude/2, scared/3, horny/4. Bare !voice shows the menu.
# Language is required by the API. Default en. BCP-47 tags such as pt-BR, or auto, also work.
# VOICE_TTS_LANGUAGE=en
